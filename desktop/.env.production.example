APP_NAME="Vault Intelligence Agency"
APP_SHORT_NAME=Vault
APP_ACRONYM=VIA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=vault_control
DB_USERNAME=vault_control
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=2160

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@vault.local
ADMIN_PASSWORD=
INITIAL_UPLOAD_KEY=

BROADCAST_DRIVER=reverb
REVERB_APP_ID=vault-control
REVERB_APP_KEY=vault-control
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY=vault-control

FILESYSTEM_DISK=local
VAULT_MAX_UPLOAD_MB=100
VAULT_MAX_VIDEO_MB=0
VAULT_API_UPLOAD_ENABLED=true
VAULT_CHUNK_SIZE_MB=5
VAULT_SENDFILE=off
VAULT_FFMPEG_PATH=
VAULT_FFPROBE_PATH=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
